NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# For projects using the legacy public anon key, set this instead of PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional local demo account; honored only in development.
# Keep these server-only values in .env.local. Supabase is used when disabled.
ATLAS_LOCAL_AUTH_ENABLED=false
ATLAS_LOCAL_AUTH_EMAIL=
ATLAS_LOCAL_AUTH_PASSWORD_HASH=
ATLAS_LOCAL_AUTH_SESSION_SECRET=
