{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Country history",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "years"],
  "properties": {
    "$schema": { "const": "./schema.json" },
    "code": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "years": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(0|[1-9][0-9]{0,3})$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capitalFa", "capitalEn", "areaKm2", "population", "flagPath"],
          "properties": {
            "capitalFa": { "type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "^[^A-Za-z]*[\u0600-\u06ff][^A-Za-z]*$", "description": "نام فارسی پایتخت؛ اگر مشخص نیست null بگذارید." },
            "capitalEn": { "type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "^[^\u0600-\u06ff]*$", "description": "نام انگلیسی پایتخت" },
            "areaKm2": { "type": ["number", "null"], "minimum": 0, "description": "مساحت بر حسب کیلومتر مربع، بدون جداکنندهٔ هزارگان" },
            "population": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
            "flagPath": { "type": ["string", "null"], "pattern": "^/flags/([a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(svg|png|webp|jpe?g|gif)$", "description": "مسیر فایل از پوشهٔ public، مثلاً /flags/de.svg" }
          }
        }
      }
    }
  }
}
